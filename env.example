# Copy to .env (DEV values only; .env is git-ignored). EXPO_PUBLIC_* values ship inside the app:
# never put a service-role key or any secret here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Your computer's Wi-Fi address where `npm run dev:api` runs (the phone cannot use localhost),
# e.g. http://192.168.1.7:4000
EXPO_PUBLIC_MARKETPLACE_API_URL=
