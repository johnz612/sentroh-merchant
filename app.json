{
  "expo": {
    "name": "Sentroh Merchant",
    "slug": "sentroh-merchant",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sentrohmerchant",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.sentroh.merchant",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.sentroh.merchant",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Sentroh uses your location to pin your store on the map so drivers and customers can find it."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E6B63"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sentroh uses your location to pin your store on the map so drivers and customers can find it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sentroh uses your photos to show your products to customers.",
          "cameraPermission": "Sentroh uses the camera to take product photos.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "03f7c6d3-4ca8-4be1-978b-53d8ffe0dba7"
      }
    },
    "icon": "./assets/icon.png",
    "owner": "johns612"
  }
}
